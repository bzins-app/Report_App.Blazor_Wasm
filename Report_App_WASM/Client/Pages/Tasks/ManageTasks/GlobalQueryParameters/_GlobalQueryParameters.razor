@using Report_App_WASM.Shared.Extensions
@inject IDialogService DialogService

<MudCard>
    <MudCardContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform: none" Size="Size.Small" OnClick="OpenCreateDialog">@Localizer.Get("Add a parameter")</MudButton>
    </MudCardContent>
    <MudCardContent Style="overflow:auto;height:100%">
        <MudTable Items="_parameters.OrderBy(a => a.DisplaySequence)" Hover="true" Dense HorizontalScrollbar Height="50vh">
            <RowTemplate>
                <MudTd DataLabel="@Localizer.Get("Delete")" Style="width:10px">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Default" OnClick="() => Delete(context)" title="@Localizer.Get("Delete")" Class="pa-2" />
                </MudTd>
                <MudTd Style="min-width:200px">
                    <MudTextField @bind-Value="@context.DisplayName" @bind-Value:after="UpdateParameters" T="string" Label="@Localizer.Get("Display name")" Margin="Margin.Dense" />
                </MudTd>
                <MudTd Style="width:200px;min-width:200px">
                    <MudNumericField Label="@Localizer.Get("Display sequence")" @bind-Value="@(context.DisplaySequence)" @bind-Value:after="UpdateParameters" Margin="Margin.Dense" />
                </MudTd>
                <MudTd Style="min-width:200px">
                    <MudTextField @bind-Value="@context.ParameterIdentifier" @bind-Value:after="UpdateParameters" T="string" Label="@Localizer.Get("Parameter identifier")" Margin="Margin.Dense" />
                </MudTd>
                <MudTd Style="min-width:200px">
                    <MudField Label="@Localizer.Get("Data type")" Margin="Margin.Dense"> @Localizer.Get(context.ValueType.ToString())</MudField>
                </MudTd>
                <MudTd>
                    @if (context.ValueType is QueryCommandParameterValueType.Date or QueryCommandParameterValueType.DateTime)
                    {
                        <MudStack Row>
                            <MudSelect @bind-Value="context.DateOption" Label="@Localizer.Get("Select a date calculation")" @bind-Value:after="UpdateParameters" Dense Margin="Margin.Dense">
                                @foreach (CalulatedDateOption item in Enum.GetValues(typeof(CalulatedDateOption)))
                                {
                                    <MudSelectItem Value="@item">@Localizer.Get(item.ToString())</MudSelectItem>
                                }
                            </MudSelect>
                            @if (context.DateOption is CalulatedDateOption.Now or CalulatedDateOption.LastRun)
                            {
                                var valueDateTime = context.DateOption == CalulatedDateOption.Now ? DateTime.Now : Item!.LastRunDateTime ?? DateTime.Now;
                                <MudField Style="min-width:200px" Margin="Margin.Dense" Label="@Localizer.Get("Calculated date")">@(context.ValueType == QueryCommandParameterValueType.Date ? valueDateTime.Date.ToString("d") : valueDateTime)</MudField>
                            }
                            else
                            {
                                <MudField Style="min-width:200px" Margin="Margin.Dense" Label="@Localizer.Get("Calculated date")">@(context.ValueType == QueryCommandParameterValueType.Date ? context.DateOption.GetCalculateDateTime().Date.ToString("d") : context.DateOption.GetCalculateDateTime())</MudField>
                            }
                        </MudStack>

                    }
                    @if (context.ValueType == QueryCommandParameterValueType.String)
                    {
                        <MudTextField InputType="InputType.Text" Label="@Localizer.Get("Enter value")" @bind-Value="@context.Value" @bind-Value:after="UpdateParameters" Text="@context.Value" />
                    }
                    @if (context.ValueType == QueryCommandParameterValueType.Number)
                    {
                        <MudTextField InputType="InputType.Number" Label="@Localizer.Get("Enter value")" @bind-Value="@(context.Value)" @bind-Value:after="UpdateParameters" Text="@context.Value" />
                    }
                </MudTd>
                <MudTd>
                    <MudSwitch @bind-Value="@context.Required" @bind-Value:after="UpdateParameters" Label="@Localizer.Get("Required")" Color="Color.Primary" />
                </MudTd>
                <MudTd>
                    <MudSwitch @bind-Value="@context.HideParameter" @bind-Value:after="UpdateParameters" Label="@Localizer.Get("Hide")" Color="Color.Primary" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {

    [Parameter] public ScheduledTaskDto? Item { get; set; }
    [Parameter] public EventCallback<bool> ChangePendingChanged { get; set; }
    [Parameter] public bool ChangePending { get; set; }

    List<QueryCommandParameter> _parameters = new();
    private bool _firstRender = true;

    protected override void OnInitialized()
    {
        if (Item?.GlobalQueryParameters != "[]" && !string.IsNullOrEmpty(Item?.GlobalQueryParameters))
        {
            _parameters = JsonSerializer.Deserialize<List<QueryCommandParameter>>(Item.GlobalQueryParameters) ?? new List<QueryCommandParameter>();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _firstRender = false;
        }
        base.OnAfterRender(firstRender);
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<_QueryParametersFormDialog>("Create");
        var feedback = await dialog.Result;

        if (!(feedback is { Canceled: true }))
        {
            if (feedback != null) _parameters?.Add(((QueryCommandParameter)feedback.Data!));
            await UpdateParameters();
        }
    }

    private async Task Delete(QueryCommandParameter element)
    {
        DialogOptions dialogOptions = new() { CloseOnEscapeKey = true, BackdropClick = true, MaxWidth = MaxWidth.ExtraSmall };
        var result = await DialogService.ShowMessageBox(Localizer.Get("Warning"), Localizer.Get("Are you sure?"), Localizer.Get("Delete"), null, Localizer.Get("Cancel"), dialogOptions);

        if (result != null)
        {
            _parameters.Remove(_parameters.FirstOrDefault(a => a.ParameterIdentifier == element.ParameterIdentifier)!);
            await UpdateParameters();
        }
    }

    private async Task UpdateParameters()
    {
        if (!_firstRender)
        {
            _parameters?.ForEach(a => a.ParameterIdentifier = a.ParameterIdentifier.RemoveSpecialCharacters());
            var _param = JsonSerializer.Serialize(_parameters);
            if (_param != Item!.GlobalQueryParameters)
            {
                Item!.GlobalQueryParameters = _param;
                ChangePending = true;
                await ChangePendingChanged.InvokeAsync(ChangePending);
            }
        }
    }

}