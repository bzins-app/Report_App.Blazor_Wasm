@using Report_App_WASM.Shared.Extensions
@inject IDialogService DialogService

<MudCard>
    <MudCardContent>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="text-transform: none" Size="Size.Small" OnClick="OpenCreateDialog">@Localizer.Get("Add a parameter")</MudButton>
    </MudCardContent>
    <MudCardContent Style="overflow:auto;height:100%">
        <MudTable Items="_parameters.OrderBy(a => a.DisplaySequence)" Hover="true" Dense HorizontalScrollbar Height="30vh" FixedHeader="true">
            <HeaderContent>
                <MudTh Style="text-wrap-mode: nowrap;"></MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Display name")</MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Display sequence")</MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Identifier")</MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Data type") @Localizer.Get("Value")</MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Required")</MudTh>
                <MudTh Style="text-wrap-mode: nowrap;">@Localizer.Get("Hide")</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudStack Row Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Default" OnClick="() => OpenEditDialog(context)" title="@Localizer.Get("Edit")"/>
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Default" OnClick="() => Delete(context)" title="@Localizer.Get("Delete")"/>
                    </MudStack>
                </MudTd>
                <MudTd>@context.DisplayName</MudTd>
                <MudTd>@context.DisplaySequence</MudTd>
                <MudTd >@context.ParameterIdentifier</MudTd>
                <MudTd>
                    <MudStack Row Spacing="1">
                        @context.ValueType
                        @if (context.ValueType is QueryCommandParameterValueType.Date or QueryCommandParameterValueType.DateTime)
                        {
                            @*  <MudText Style="text-wrap-mode: nowrap;font-size:.75rem">@context.DateOption</MudText> *@
                            <MudText >
                                @if (context.DateOption is CalulatedDateOption.Now or CalulatedDateOption.LastRun)
                                {
                                    var valueDateTime = DateTime.Now;
                                    @(context.ValueType == QueryCommandParameterValueType.Date ? valueDateTime.Date.ToString("d") : valueDateTime)
                                }
                                else
                                {
                                    @(context.ValueType == QueryCommandParameterValueType.Date ? context.DateOption.GetCalculateDateTime().Date.ToString("d") : context.DateOption.GetCalculateDateTime())
                                }
                            </MudText>
                        }
                        else
                        {
                            <MudText >
                                @context.Value
                            </MudText>
                        }
                    </MudStack>
                </MudTd>
                <MudTd>
                    <MudSwitch @bind-Value="@context.Required" @bind-Value:after="UpdateParameters" Color="Color.Primary"/>
                </MudTd>
                <MudTd>
                    <MudSwitch @bind-Value="@context.HideParameter" @bind-Value:after="UpdateParameters" Color="Color.Primary"/>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {

    [Parameter] public ScheduledTaskDto? Item { get; set; }
    [Parameter] public EventCallback<bool> ChangePendingChanged { get; set; }
    [Parameter] public bool ChangePending { get; set; }

    List<QueryCommandParameter> _parameters = new();
    private bool _firstRender = true;

    protected override void OnInitialized()
    {
        if (Item?.GlobalQueryParameters != "[]" && !string.IsNullOrEmpty(Item?.GlobalQueryParameters))
        {
            _parameters = JsonSerializer.Deserialize<List<QueryCommandParameter>>(Item.GlobalQueryParameters) ?? new List<QueryCommandParameter>();
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _firstRender = false;
        }

        base.OnAfterRender(firstRender);
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<_QueryParametersFormDialog>("Create");
        var feedback = await dialog.Result;

        if (!(feedback is { Canceled: true }))
        {
            if (feedback != null) _parameters?.Add(((QueryCommandParameter)feedback.Data!));
            await UpdateParameters();
        }
    }

    private async Task Delete(QueryCommandParameter element)
    {
        DialogOptions dialogOptions = new() { CloseOnEscapeKey = true, BackdropClick = true, MaxWidth = MaxWidth.ExtraSmall };
        var result = await DialogService.ShowMessageBoxAsync(Localizer.Get("Warning"), Localizer.Get("Are you sure?"), Localizer.Get("Delete"), null, Localizer.Get("Cancel"), dialogOptions);

        if (result != null)
        {
            _parameters.Remove(_parameters.FirstOrDefault(a => a.ParameterIdentifier == element.ParameterIdentifier)!);
            await UpdateParameters();
        }
    }

    private async Task UpdateParameters()
    {
        if (!_firstRender)
        {
            _parameters?.ForEach(a => a.ParameterIdentifier = a.ParameterIdentifier.RemoveSpecialCharacters());
            var _param = JsonSerializer.Serialize(_parameters);
            if (_param != Item!.GlobalQueryParameters)
            {
                Item!.GlobalQueryParameters = _param;
                ChangePending = true;
                await ChangePendingChanged.InvokeAsync(ChangePending);
            }
        }
    }

    private async Task OpenEditDialog(QueryCommandParameter element)
    {
        var CopyElement = new QueryCommandParameter { DisplayName = element.DisplayName, ParameterIdentifier = element.ParameterIdentifier, Value = element.Value, ValueType = element.ValueType, DateOption = element.DateOption, Required = element.Required, HideParameter = element.HideParameter, DisplaySequence = element.DisplaySequence };
        var parameters = new DialogParameters<_QueryParametersFormDialog> { { x => x._param, CopyElement }, { a => a.UseAllParameters, true } };
        var dialog = await DialogService.ShowAsync<_QueryParametersFormDialog>("Edit", parameters);
        var feedback = await dialog.Result;

        if (!(feedback is { Canceled: true }))
        {
            if (feedback != null)
            {
                element.ParameterIdentifier = CopyElement.ParameterIdentifier;
                element.DateOption = CopyElement.DateOption;
                element.Value = CopyElement.Value;
                element.ValueType = CopyElement.ValueType;
                element.DisplayName = CopyElement.DisplayName;
                element.Required = CopyElement.Required;
                element.HideParameter = CopyElement.HideParameter;
                element.DisplaySequence = CopyElement.DisplaySequence;
                await UpdateParameters();
            }
        }
    }

}