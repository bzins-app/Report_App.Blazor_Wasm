@inherits BaseGridComponent<TaskLogDto>
@inject IDialogService DialogService

<ErrorBoundary>
    <MudCard Elevation="6">
        <MudCardHeader>
            <MudText Typo="Typo.h6">@Title</MudText>
            <MudSpacer/>
            <MudStack Row="true">
                <MudIconButton Variant="Variant.Outlined"
                Size="Size.Small"
                OnClick="@(OnRefresh)"
                Icon="@Icons.Material.Filled.Refresh" title="@Localizer.Get("Refresh")" Disabled="@_rendering"/>
                <MudIconButton Variant="Variant.Outlined"
                Size="Size.Small"
                OnClick="@(RemoveFilters)"
                Icon="@Icons.Material.Filled.FilterAltOff" title="@Localizer.Get("Remove filters")" Disabled="@_rendering"/>
                <MudIconButton Variant="Variant.Outlined"
                Size="Size.Small"
                OnClick="@(ExtractElements)"
                Icon="@Icons.Material.Filled.Download" title="@Localizer.Get("Download")" Disabled="@_rendering"/>
            </MudStack>
        </MudCardHeader>
        <MudCardContent>
            <div style="overflow: auto;text-wrap-mode: nowrap;">
                <SimpleGrid ItemsProvider="@_itemsProvider" BuildInFilter="true" Pagination="@_pagination" FieldsContent="@_translations" @ref="_grid">
                    <Blazor.SimpleGrid.TemplateColumn >
                        <MudIconButton Style="padding: 0px !important" Icon="@Icons.Material.Outlined.Article" OnClick="() => OpenDetails(context.TaskLogId)" title="@Localizer.Get("Display details")" Disabled="!context.HasSteps"/>
                    </Blazor.SimpleGrid.TemplateColumn>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.TaskLogId)" Title="TaskLogId" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.Type)" Title="@Localizer.Get("Type of job")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.JobDescription)" Title="@Localizer.Get("Job description")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.StartDateTime)" Title="@Localizer.Get("Start date time")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.EndDateTime)" Title="@Localizer.Get("End date time")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.Error)" Title="@Localizer.Get("Error?")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.DurationInSeconds)" Title="@Localizer.Get("Duration in seconds")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.ProviderName)" Title="@Localizer.Get("Activity name")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.RunBy)" Title="@Localizer.Get("Run by")" Sortable="true"/>
                    <Blazor.SimpleGrid.PropertyColumn Property="@(p => p.Result)" Title="@Localizer.Get("Result")" Sortable="true"/>
                </SimpleGrid>
            </div>
            @if (_rendering)
            {
                <MudProgressLinear Color="Color.Info" Indeterminate="@_rendering"/>
            }
            <Paginator Value="@_pagination" FieldsContent="@_translations"/>
        </MudCardContent>
    </MudCard>
</ErrorBoundary>

@code
{
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool? Error { get; set; }
    [Parameter] public long? ScheduledTaskId { get; set; }
    [Parameter] public DateTime? From { get; set; }
    [Parameter] public DateTime? To { get; set; }
    [Parameter] public int? PageSize { get; set; }

    new PaginationState _pagination = new() { ItemsPerPage = 20 };
    string customFilters = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _pagination.ItemsPerPage = PageSize ?? 20;
    }

    protected override async Task<ApiResponse<TaskLogDto>?> GetRemoteData(GridItemsProviderRequest<TaskLogDto> req)
    {
        // Convert the current data request and filter criteria into an HTTP request to the remote endpoint
        // You can have as many filter criteria as you want as long as you can express this to the underlying data provider
        var odataQuery = _grid?.GetODataQuery();
        var url = "odata/TaskLogs?";


        var odataSort = _grid?.GetODataSortValues();
        var odataPagination = _grid?.GetODataPaginationValues();
        var odataFilters = _grid?.GetODataFilterValues();

        SetCustomFilters();

        if (!string.IsNullOrEmpty(customFilters))
        {
            url += $"$count=true";
            if (!string.IsNullOrEmpty(odataPagination)) url += "&" + odataPagination;
            if (!string.IsNullOrEmpty(odataSort)) url += "&" + odataSort;
            if (!string.IsNullOrEmpty(odataFilters)) url += "&" + odataFilters + " and " + customFilters;
            else url += "&$filter=" + customFilters;
        }
        else
        if (string.IsNullOrEmpty(odataQuery))
        {
            url += $"$count=true&$top={_pagination.ItemsPerPage}";
        }
        else
        {
            url += odataQuery;
        }
        try
        {
            return await DataService.GetODataValues<TaskLogDto>(url, req.CancellationToken);
        }
        catch
        {
            // Unfortunately this HTTP API returns a 404 if there were no results, so we have to handle that separately
            return null;
        }
    }


    private async Task ExtractElements()
    {
        _rendering = true;
        SetCustomFilters();
        string fname = "TaskLogs";
        var odataQuery = _grid?.GetODataQueryWihtoutPagination();
        var odataSort = _grid?.GetODataSortValues();
        var odataPagination = _grid?.GetODataPaginationValues();
        var odataFilters = _grid?.GetODataFilterValues();
        var url = "odata/ExtractTaskLogs?";
        if (!string.IsNullOrEmpty(customFilters))
        {
            if (!string.IsNullOrEmpty(odataPagination)) url += "&" + odataPagination;
            if (!string.IsNullOrEmpty(odataSort)) url += "&" + odataSort;
            if (!string.IsNullOrEmpty(odataFilters)) url += "&" + odataFilters + " and " + customFilters;
            else url += "&$filter=" + customFilters;
        }
        else
        {
            url += odataQuery;
        }
        url += odataQuery;
        await DataService.ExtractGridLogs(url, fname);
        _rendering = false;
    }


    private async Task OpenDetails(long taksId)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters { ["taskId"] = taksId };
        await DialogService.ShowAsync<_TaskDetails>(Localizer.Get("Job details"), parameters, options);
    }

    private void SetCustomFilters()
    {
        customFilters = string.Empty;
        if (Error.HasValue)
        {

            if (!string.IsNullOrEmpty(customFilters))
            {
                customFilters += $" and Error eq {Error.Value.ToString().ToLower()}";
            }
            else
            {
                customFilters = $"Error eq {Error.Value.ToString().ToLower()}";
            }
        }
        if (ScheduledTaskId.HasValue)
        {

            if (!string.IsNullOrEmpty(customFilters))
            {
                customFilters += $" and ScheduledTaskId eq {ScheduledTaskId.Value}";
            }
            else
            {
                customFilters = $"ScheduledTaskId eq {ScheduledTaskId.Value}";
            }
        }
        if (From.HasValue)
        {

            if (!string.IsNullOrEmpty(customFilters))
            {
                customFilters += $" and StartDateTime ge {From.Value:yyyy-MM-ddTHH:mm:ss.fffZ}";
            }
            else
            {
                customFilters = $"StartDateTime ge {From.Value:yyyy-MM-ddTHH:mm:ss.fffZ}";
            }
        }
        if (To.HasValue)
        {
            if (!string.IsNullOrEmpty(customFilters))
            {
                customFilters += $" and EndDateTime le {To.Value:yyyy-MM-ddTHH:mm:ss.fffZ}";
            }
            else
            {
                customFilters = $"EndDateTime le {To.Value:yyyy-MM-ddTHH:mm:ss.fffZ}";
            }
        }
    }
}